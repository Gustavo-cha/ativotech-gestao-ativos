# ============================================================================
#  Ativos Tech — configuração da API
#  Copie este arquivo para "api/.env" e preencha. O arquivo .env NÃO vai para o
#  repositório (.gitignore). Variáveis definidas no ambiente têm prioridade.
# ============================================================================

# Endereço do front-end (links dos e-mails e retorno do login Microsoft)
APP_URL=http://localhost:3000
# Endereço público da API (usado para montar o redirect do login Microsoft)
API_PUBLIC_URL=http://localhost:3001
PORT=3001

# ---------------------------------------------------------------------------
# Administrador inicial (Operador TI com permissão administrativa e licença ativa)
# A conta é criada UMA vez, na primeira inicialização, se ainda não existir.
# A senha é guardada apenas como hash (scrypt) e a troca é exigida no 1º acesso.
# Depois que a conta existir, APAGUE o valor de ADMIN_INITIAL_PASSWORD.
# Alternativa sem deixar a senha em arquivo: pare a API e rode  npm run criar-admin
# ---------------------------------------------------------------------------
ADMIN_EMAIL=gusilva@hco.com
# Nome exibido no sistema (opcional; o comando criar-admin também pergunta)
ADMIN_NOME=
ADMIN_INITIAL_PASSWORD=

# Domínios aceitos como e-mail corporativo no cadastro de usuários (separe por vírgula)
EMAIL_DOMINIOS_PERMITIDOS=hco.com
# Domínios aceitos no e-mail corporativo dos COLABORADORES que recebem equipamentos (vazio = qualquer e-mail válido)
# Ex.: EMAIL_DOMINIOS_COLABORADORES=hco.com,b2finance.com
EMAIL_DOMINIOS_COLABORADORES=
# Licenças configuradas na primeira inicialização (depois ajuste em Gerenciamento de Usuários)
LICENCAS_TOTAL=10

# ---------------------------------------------------------------------------
# Login com Microsoft (Entra ID — OAuth 2.0 / OpenID Connect)
# Registro de aplicativo: Web · Redirect URI = <API_PUBLIC_URL>/api/auth/microsoft/callback
# Deixe em branco para manter o botão visível, mas indisponível.
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# MS_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# ---------------------------------------------------------------------------
# Notificações por e-mail — escolha UM provedor: smtp ou graph
# ---------------------------------------------------------------------------
EMAIL_PROVEDOR=
EMAIL_REMETENTE=ativostech@hco.com
EMAIL_NOME_REMETENTE=Ativos Tech

# SMTP (ex.: Microsoft 365: smtp.office365.com, porta 587, STARTTLS — exige SMTP AUTH liberado na caixa)
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_EXIGIR_TLS=true
SMTP_USUARIO=
SMTP_SENHA=

# Microsoft Graph (recomendado no Microsoft 365): permissão de APLICATIVO "Mail.Send" com consentimento
# de administrador. Se vazios, usam MS_TENANT_ID / MS_CLIENT_ID / MS_CLIENT_SECRET.
# Restrinja o envio à caixa do remetente com uma Application Access Policy no Exchange Online.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
